# Copy to terraform.tfvars (git-ignored) and fill in. Or export TF_VAR_hcloud_token.

hcloud_token = "REPLACE_ME"

# Public key you will log in with (root, on port ssh_port).
ssh_public_key_file = "~/.ssh/id_ed25519.pub"

# Restrict SSH to your own address for anything that lives longer than a day:
# admin_cidrs = ["203.0.113.7/32"]

# --- Names and TLS ---------------------------------------------------------------
# Default (both empty): gitlab.<ip>.nip.io, needs no DNS at all.
#
# Your own domain, DNS managed by you: set base_domain and create the two A records
# that "terraform output dns_records_to_create" prints.
# base_domain = "training.example.com"
#
# Your own domain in Hetzner DNS: also set dns_zone and Terraform creates the records.
# dns_zone    = "example.com"
#
# Your own domain in Cloudflare: set cloudflare_zone (instead of dns_zone) and an API TOKEN limited to that
# zone with Zone > Zone > Read and Zone > DNS > Edit. A zone ID is not a token. Keep the token in a
# git-ignored terraform.auto.tfvars or TF_VAR_cloudflare_api_token. Records are created DNS only.
# cloudflare_zone      = "example.com"
# cloudflare_api_token = "REPLACE_ME"
# acme_email  = "you@example.com"

# --- Sizing (see variables.tf) ----------------------------------------------------
# gitlab_server_type = "cx43"   # 8 vCPU / 16 GB
# runner_server_type = "cx33"
# location           = "fsn1"
