#cloud-config
# GitLab VM: GitLab (Podman Quadlet) + Caddy (TLS). Rendered by Terraform.
# Follow progress after boot:  tail -f /var/log/training-provision.log

package_update: true
package_upgrade: false
packages:
  - podman
  - netavark
  - aardvark-dns
  - curl
  - jq
  - ca-certificates

ssh_pwauth: false

write_files:
  # Settings for the scripts below. Contains secrets, root-only.
  - path: /etc/training/env
    permissions: "0600"
    content: |
      SSH_PORT=${ssh_port}
      SWAP_GB=${swap_gb}
      GITLAB_IMAGE=${gitlab_image}
      GITLAB_FQDN=${gitlab_fqdn}
      BOOTSTRAP_TOKEN=${bootstrap_token}
      ADMIN_USERNAME='${admin_username}'
      ADMIN_EMAIL='${admin_email}'

  # Key-only SSH on a non-standard port; port 22 is left to GitLab.
  - path: /etc/ssh/sshd_config.d/10-training.conf
    permissions: "0644"
    content: |
      Port ${ssh_port}
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin prohibit-password

  - path: /usr/local/sbin/training-move-sshd
    permissions: "0755"
    content: |
      ${indent(6, script_move_sshd)}

  - path: /usr/local/sbin/training-gitlab-provision
    permissions: "0755"
    content: |
      ${indent(6, script_provision)}

  - path: /usr/local/sbin/training-gitlab-bootstrap
    permissions: "0755"
    content: |
      ${indent(6, script_bootstrap)}

  - path: /etc/systemd/system/training-gitlab-bootstrap.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Create the runner bootstrap token and apply instance settings
      Requires=gitlab.service
      After=gitlab.service
      # Runs once. The runner VM revokes the token it creates; it must never come back.
      ConditionPathExists=!/var/lib/training/gitlab-bootstrap.done

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/local/sbin/training-gitlab-bootstrap
      Restart=on-failure
      RestartSec=60
      TimeoutStartSec=3600

      [Install]
      WantedBy=multi-user.target

  # --- GitLab configuration (mounted into the container as /etc/gitlab) ---
  - path: /srv/gitlab/config/gitlab.rb
    permissions: "0600"
    content: |
      ${indent(6, gitlab_rb)}

  # Must be world-readable: `gitlab-rails runner` drops to the `git` user, and "the script must be accessible by the git user"
  # (GitLab docs, rails_console). With 0600 root-owned the runner fails with LoadError, the unit retries forever, and neither
  # the settings nor the bootstrap token are ever applied. The file holds no secret (the token arrives as an environment variable).
  - path: /srv/gitlab/config/bootstrap.rb
    permissions: "0644"
    content: |
      ${indent(6, bootstrap_rb)}

  # --- Podman Quadlets: rootful, system-wide ---
  - path: /etc/containers/systemd/gitlab.network
    permissions: "0644"
    content: |
      [Network]
      NetworkName=gitlab

  - path: /etc/containers/systemd/gitlab.container
    permissions: "0644"
    content: |
      ${indent(6, gitlab_container)}

  - path: /etc/containers/systemd/caddy.container
    permissions: "0644"
    content: |
      [Unit]
      Description=Caddy reverse proxy and TLS for GitLab
      Wants=network-online.target
      After=network-online.target gitlab.service

      [Container]
      Image=docker.io/library/caddy:2
      ContainerName=caddy
      Network=gitlab.network
      PublishPort=80:80
      PublishPort=443:443
      PublishPort=443:443/udp
      Volume=/etc/caddy/Caddyfile:/etc/caddy/Caddyfile:ro
      # Certificates and ACME account: keep them across restarts to stay below rate limits.
      Volume=caddy-data:/data
      Volume=caddy-config:/config

      [Service]
      Restart=always

      [Install]
      WantedBy=multi-user.target

  - path: /etc/caddy/Caddyfile
    permissions: "0644"
    content: |
      ${indent(6, caddyfile)}

runcmd:
  - [/usr/local/sbin/training-gitlab-provision]
